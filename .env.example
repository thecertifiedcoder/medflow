# ==============================================================================
# MedFlow — Environment Variable Template (Placeholders Only — Never Commit Secrets)
# Copy to .env.local for local development. In Google AI Studio, configure
# server-side secrets in Settings > Secrets.
# ==============================================================================

# --- Public Client-Safe Configuration (NEXT_PUBLIC_*) ---
# Public intake code for the single preconfigured synthetic demo facility.
NEXT_PUBLIC_DEMO_FACILITY_PUBLIC_CODE=DEMO-CLINIC-01
NEXT_PUBLIC_APP_ENV=development
# Optional: set to "true" on custom HTTPS domains whose /__/auth/handler redirect URI is registered in Google OAuth.
# Automatically enabled on Google AI Studio Preview *.run.app origins.
NEXT_PUBLIC_FIREBASE_SAME_ORIGIN_AUTH_DOMAIN=false

# --- Server-Only Neon PostgreSQL Configuration (Never expose to browser) ---
# Pooled Neon connection string used by Next.js Route Handlers at runtime:
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/medflow?sslmode=require
# Direct (unpooled) Neon connection string used exclusively by Drizzle Kit migrations:
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/medflow?sslmode=require

# --- Server-Only Gemini Configuration (Never expose to browser) ---
# Configured via Google AI Studio Settings > Secrets or deployment host secrets.
GEMINI_API_KEY=your-server-side-gemini-api-key
GEMINI_EXTRACTION_MODEL=gemini-4-hydrogen
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# --- Server-Only Audio Validation Limits ---
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_AUDIO_DURATION_SECONDS=90

# --- Server-Only Facility Mapping (Single Canonical Synthetic Demo Facility) ---
DEMO_FACILITY_ID=demo-clinic-01
DEMO_FACILITY_NAME="MedFlow Synthetic Demo Clinic"

# --- Firebase Authentication Configuration (Identity Provider Only) ---
# Public Firebase Web SDK identifiers are loaded via firebase-applet-config.json.
# Server-side firebase-admin/auth verifies Firebase ID tokens via projectId without service-account JSON keys.
# Note: EVIDENCE_HMAC_SECRET is deferred until Milestone 3 (Evidence Integrity Engine).

