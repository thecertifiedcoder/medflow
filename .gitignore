coverage/
.playwright-cli/
playwright-report/
test-results/

# Raw audio recordings — never commit patient or synthetic audio uploads
*.webm
*.wav
*.mp3
*.m4a
*.ogg

# OS / editor artifacts
.DS_Store
Thumbs.db
