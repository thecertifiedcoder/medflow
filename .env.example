# ==============================================================================
# MedFlow — Environment Variable Template (Placeholders Only — Never Commit Secrets)
# Copy to .env.local for local development. In Google AI Studio, configure
# server-side secrets in Settings > Secrets.
# ==============================================================================

# --- Public Client-Safe Configuration (NEXT_PUBLIC_*) ---
# Public intake code for the single preconfigured synthetic demo facility.
NEXT_PUBLIC_DEMO_FACILITY_PUBLIC_CODE=DEMO-FACILITY
NEXT_PUBLIC_APP_ENV=development

# --- Server-Only Gemini Configuration (Never expose to browser) ---
# Configured via Google AI Studio Settings > Secrets or deployment host secrets.
GEMINI_API_KEY=your-server-side-gemini-api-key
GEMINI_EXTRACTION_MODEL=gemini-4-hydrogen
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# --- Server-Only Audio Validation Limits ---
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_AUDIO_DURATION_SECONDS=90

# --- Server-Only Facility Mapping (Single Demo Facility for MVP) ---
DEMO_FACILITY_ID=demo-facility-001
DEMO_FACILITY_NAME="MedFlow Synthetic Demo Facility"

# --- Firebase Configuration (Provisioned in Milestone 1B — Not Active in 1A) ---
# Public Firebase Web SDK identifiers (populated via firebase-applet-config.json or env):
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=
#
# Server-side Firebase Admin SDK (user-owned project with ADC/IAM only — never commit JSON keys):
# FIREBASE_PROJECT_ID=
# FIREBASE_DATABASE_ID=
