rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL SAFETY NET — Default Deny Everything
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // GLOBAL PRIMITIVES & ZERO-TRUST HELPERS
    // =========================================================================
    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true;
    }

    // Trusted staff authorization lookup (no client custom claims, no email bootstrap)
    function staffDocPath() {
      return /databases/$(database)/documents/staff/$(request.auth.uid);
    }

    function hasActiveStaffProfile() {
      return isVerifiedEmail()
        && exists(staffDocPath())
        && get(staffDocPath()).data.active == true
        && get(staffDocPath()).data.uid == request.auth.uid
        && get(staffDocPath()).data.role in ['nurse', 'doctor', 'admin']
        && get(staffDocPath()).data.facilityIds is list
        && get(staffDocPath()).data.facilityIds.size() >= 1
        && get(staffDocPath()).data.facilityIds.size() <= 10;
    }

    function isActiveStaffForFacility(facilityId) {
      return hasActiveStaffProfile()
        && facilityId is string
        && facilityId in get(staffDocPath()).data.facilityIds;
    }

    function isFacilityAdmin(facilityId) {
      return isActiveStaffForFacility(facilityId)
        && get(staffDocPath()).data.role == 'admin';
    }

    function isActiveFacility(facilityId) {
      return isValidId(facilityId)
        && exists(/databases/$(database)/documents/facilities/$(facilityId))
        && get(/databases/$(database)/documents/facilities/$(facilityId)).data.active == true;
    }

    // =========================================================================
    // VALIDATION BLUEPRINTS — IntakeRecord & AuditEvent
    // =========================================================================
    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data)
        || (data[field] is string
            && data[field].size() >= minLen
            && data[field].size() <= maxLen);
    }

    function isValidOptionalAge(data) {
      return !('age' in data)
        || (data.age is int && data.age >= 0 && data.age <= 120);
    }

    function isValidAiBrief(brief) {
      return brief is map
        && brief.keys().hasAll([
          'schemaVersion',
          'chiefConcern',
          'symptoms',
          'relevantContext',
          'reportedDetailsToReview',
          'missingOrUnclear',
          'clinicianSummary',
          'limitations'
        ])
        && brief.keys().hasOnly([
          'schemaVersion',
          'languageDetected',
          'chiefConcern',
          'symptoms',
          'relevantContext',
          'reportedDetailsToReview',
          'missingOrUnclear',
          'clinicianSummary',
          'limitations'
        ])
        && brief.schemaVersion == '1.0'
        && isValidOptionalString(brief, 'languageDetected', 1, 40)
        && brief.chiefConcern is map
        && brief.chiefConcern.keys().hasAll(['value', 'certainty'])
        && brief.chiefConcern.keys().hasOnly(['value', 'sourceQuote', 'certainty'])
        && brief.chiefConcern.value is string
        && brief.chiefConcern.value.size() >= 1
        && brief.chiefConcern.value.size() <= 300
        && brief.chiefConcern.certainty in ['explicit', 'unclear']
        && isValidOptionalString(brief.chiefConcern, 'sourceQuote', 1, 500)
        && brief.symptoms is list
        && brief.symptoms.size() <= 20
        && (brief.symptoms.size() == 0 || brief.symptoms[0] is map)
        && brief.relevantContext is list
        && brief.relevantContext.size() <= 20
        && (brief.relevantContext.size() == 0 || brief.relevantContext[0] is map)
        && brief.reportedDetailsToReview is list
        && brief.reportedDetailsToReview.size() <= 15
        && (brief.reportedDetailsToReview.size() == 0 || brief.reportedDetailsToReview[0] is map)
        && brief.missingOrUnclear is list
        && brief.missingOrUnclear.size() <= 20
        && (brief.missingOrUnclear.size() == 0 || brief.missingOrUnclear[0] is string)
        && brief.clinicianSummary is string
        && brief.clinicianSummary.size() >= 1
        && brief.clinicianSummary.size() <= 1200
        && brief.limitations is list
        && brief.limitations.size() >= 1
        && brief.limitations.size() <= 10
        && brief.limitations[0] is string;
    }

    function isValidAiBriefProvenance(prov) {
      return prov is map
        && prov.keys().hasAll([
          'model',
          'schemaVersion',
          'verifiedByServer',
          'contentHash'
        ])
        && prov.keys().hasOnly([
          'model',
          'schemaVersion',
          'verifiedByServer',
          'contentHash',
          'verifiedAt'
        ])
        && prov.model is string
        && prov.model.size() >= 1
        && prov.model.size() <= 80
        && prov.schemaVersion == '1.0'
        && prov.verifiedByServer == true
        && prov.contentHash is string
        && prov.contentHash.size() >= 16
        && prov.contentHash.size() <= 128
        && (!('verifiedAt' in prov) || prov.verifiedAt is timestamp);
    }

    function isValidIntakeCoreShape(data, intakeId) {
      return data.id == intakeId
        && isValidId(data.id)
        && isValidId(data.facilityId)
        && data.referenceCode is string
        && data.referenceCode.size() >= 4
        && data.referenceCode.size() <= 32
        && data.referenceCode.matches('^[A-Z0-9\\-]+$')
        && isValidOptionalString(data, 'patientDisplayName', 1, 80)
        && isValidOptionalAge(data)
        && data.inputMode in ['typed', 'voice']
        && data.transcriptionStatus in ['not_applicable', 'succeeded', 'failed']
        && isValidOptionalString(data, 'transcriptRaw', 1, 4000)
        && data.confirmedNarrative is string
        && data.confirmedNarrative.size() >= 5
        && data.confirmedNarrative.size() <= 4000
        && data.aiStatus in [
          'queued',
          'processing',
          'succeeded',
          'failed',
          'needs_human_clarification'
        ]
        && data.staffReviewStatus in ['not_reviewed', 'confirmed', 'corrected']
        && data.staffAssignedPriority in [
          'unassigned',
          'immediate_review',
          'priority_review',
          'routine_review'
        ]
        && data.workflowStatus in [
          'new',
          'in_review',
          'awaiting_clarification',
          'completed'
        ]
        && data.idempotencyKey is string
        && data.idempotencyKey.size() >= 8
        && data.idempotencyKey.size() <= 128
        && data.idempotencyKey.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidId(data.initialAuditEventId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIntakeCreate(data, intakeId) {
      return data.keys().hasAll([
          'id',
          'facilityId',
          'referenceCode',
          'inputMode',
          'transcriptionStatus',
          'confirmedNarrative',
          'aiStatus',
          'staffReviewStatus',
          'staffAssignedPriority',
          'workflowStatus',
          'idempotencyKey',
          'initialAuditEventId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'facilityId',
          'referenceCode',
          'patientDisplayName',
          'age',
          'inputMode',
          'transcriptionStatus',
          'transcriptRaw',
          'confirmedNarrative',
          'aiStatus',
          'staffReviewStatus',
          'staffAssignedPriority',
          'workflowStatus',
          'idempotencyKey',
          'initialAuditEventId',
          'createdAt',
          'updatedAt'
        ])
        && isValidIntakeCoreShape(data, intakeId)
        && data.aiStatus == 'queued'
        && data.staffReviewStatus == 'not_reviewed'
        && data.staffAssignedPriority == 'unassigned'
        && data.workflowStatus == 'new'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidIntakeUpdateShape(data, intakeId) {
      return data.keys().hasAll([
          'id',
          'facilityId',
          'referenceCode',
          'inputMode',
          'transcriptionStatus',
          'confirmedNarrative',
          'aiStatus',
          'staffReviewStatus',
          'staffAssignedPriority',
          'workflowStatus',
          'idempotencyKey',
          'initialAuditEventId',
          'lastAuditEventId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'facilityId',
          'referenceCode',
          'patientDisplayName',
          'age',
          'inputMode',
          'transcriptionStatus',
          'transcriptRaw',
          'confirmedNarrative',
          'aiStatus',
          'aiBrief',
          'aiBriefProvenance',
          'aiErrorCode',
          'staffReviewStatus',
          'staffBrief',
          'staffCorrectionNote',
          'staffAssignedPriority',
          'priorityReason',
          'workflowStatus',
          'idempotencyKey',
          'initialAuditEventId',
          'lastAuditEventId',
          'reviewedByUid',
          'reviewedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidIntakeCoreShape(data, intakeId)
        && isValidId(data.lastAuditEventId)
        && (!('aiBrief' in data) || isValidAiBrief(data.aiBrief))
        && (!('aiBriefProvenance' in data) || isValidAiBriefProvenance(data.aiBriefProvenance))
        && isValidOptionalString(data, 'aiErrorCode', 1, 80)
        && (!('staffBrief' in data) || isValidAiBrief(data.staffBrief))
        && isValidOptionalString(data, 'staffCorrectionNote', 1, 500)
        && isValidOptionalString(data, 'priorityReason', 1, 500)
        && (!('reviewedByUid' in data) || data.reviewedByUid == request.auth.uid)
        && (!('reviewedAt' in data) || data.reviewedAt is timestamp)
        && data.updatedAt == request.time;
    }

    function preservesImmutableIntakeFields() {
      return incoming().id == existing().id
        && incoming().facilityId == existing().facilityId
        && incoming().referenceCode == existing().referenceCode
        && incoming().inputMode == existing().inputMode
        && incoming().transcriptionStatus == existing().transcriptionStatus
        && incoming().confirmedNarrative == existing().confirmedNarrative
        && incoming().idempotencyKey == existing().idempotencyKey
        && incoming().initialAuditEventId == existing().initialAuditEventId
        && incoming().createdAt == existing().createdAt
        && (('patientDisplayName' in incoming()) == ('patientDisplayName' in existing())
            && (!('patientDisplayName' in existing()) || incoming().patientDisplayName == existing().patientDisplayName))
        && (('age' in incoming()) == ('age' in existing())
            && (!('age' in existing()) || incoming().age == existing().age))
        && (('transcriptRaw' in incoming()) == ('transcriptRaw' in existing())
            && (!('transcriptRaw' in existing()) || incoming().transcriptRaw == existing().transcriptRaw));
    }

    function isValidWorkflowTransition(fromStatus, toStatus) {
      return fromStatus == toStatus
        || (fromStatus == 'new' && toStatus in ['in_review', 'awaiting_clarification'])
        || (fromStatus == 'in_review' && toStatus in ['awaiting_clarification', 'completed'])
        || (fromStatus == 'awaiting_clarification' && toStatus in ['in_review', 'completed']);
    }

    function isValidAuditEvent(data, intakeId, eventId) {
      return data.keys().hasAll([
          'id',
          'facilityId',
          'intakeId',
          'actorType',
          'action',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'facilityId',
          'intakeId',
          'actorType',
          'actorUid',
          'actorRole',
          'actorDisplayName',
          'action',
          'fromValue',
          'toValue',
          'reason',
          'createdAt'
        ])
        && data.id == eventId
        && isValidId(data.id)
        && isValidId(data.facilityId)
        && data.intakeId == intakeId
        && isValidId(data.intakeId)
        && data.actorType in ['patient', 'staff', 'system']
        && data.action in [
          'intake_created',
          'transcript_confirmed',
          'ai_completed',
          'ai_failed',
          'review_started',
          'priority_assigned',
          'priority_changed',
          'status_changed',
          'brief_confirmed',
          'brief_corrected'
        ]
        && isValidOptionalString(data, 'actorDisplayName', 1, 120)
        && isValidOptionalString(data, 'fromValue', 1, 120)
        && isValidOptionalString(data, 'toValue', 1, 120)
        && isValidOptionalString(data, 'reason', 1, 500)
        && data.createdAt == request.time
        && (
          (data.actorType == 'staff'
            && 'actorUid' in data
            && 'actorRole' in data
            && isValidId(data.actorUid)
            && data.actorRole in ['nurse', 'doctor', 'admin'])
          ||
          (data.actorType in ['patient', 'system']
            && !('actorUid' in data)
            && !('actorRole' in data))
        );
    }

    // =========================================================================
    // COLLECTION 1: /facilities/{facilityId}
    // Option 2B: Provisioned exclusively in Firebase Console; no client writes.
    // =========================================================================
    match /facilities/{facilityId} {
      allow get: if isValidId(facilityId) && existing().active == true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // COLLECTION 2: /staff/{uid}
    // Option 2B: Provisioned exclusively in Firebase Console; owner-only get.
    // =========================================================================
    match /staff/{uid} {
      allow get: if isVerifiedEmail()
        && isValidId(uid)
        && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // COLLECTION 3: /intakes/{intakeId}
    // Write-only public create with atomic patient audit; facility-scoped staff
    // reads and action-based updates with brand-new atomic audit (Option 1B).
    // =========================================================================
    match /intakes/{intakeId} {
      allow get: if isValidId(intakeId)
        && isActiveStaffForFacility(existing().facilityId);

      // Enforces facility scoping against resource.data; client queries MUST
      // include where('facilityId', '==', ...) or Firestore rejects the query.
      allow list: if isActiveStaffForFacility(existing().facilityId);

      allow create: if isValidId(intakeId)
        && isValidIntakeCreate(incoming(), intakeId)
        && isActiveFacility(incoming().facilityId)
        && !exists(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().initialAuditEventId))
        && existsAfter(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().initialAuditEventId));

      allow update: if isVerifiedEmail()
        && isValidId(intakeId)
        && isValidIntakeUpdateShape(incoming(), intakeId)
        && preservesImmutableIntakeFields()
        && isActiveStaffForFacility(existing().facilityId)
        && (existing().workflowStatus != 'completed' || isFacilityAdmin(existing().facilityId))
        && !exists(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().lastAuditEventId))
        && existsAfter(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().lastAuditEventId))
        && (
          // Action 1 (Option 1B): Attach server-verified AI brief or failure state
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'aiStatus',
            'aiBrief',
            'aiBriefProvenance',
            'aiErrorCode',
            'lastAuditEventId',
            'updatedAt'
          ])
          && (incoming().aiStatus != 'succeeded'
              || ('aiBrief' in incoming() && 'aiBriefProvenance' in incoming()))
          && getAfter(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().lastAuditEventId)).data.actorType == 'system'
          && getAfter(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().lastAuditEventId)).data.action in ['ai_completed', 'ai_failed'])
          ||
          // Action 2: Staff starts review, confirms or corrects brief (stored separately in staffBrief)
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'staffReviewStatus',
            'staffBrief',
            'staffCorrectionNote',
            'workflowStatus',
            'reviewedByUid',
            'reviewedAt',
            'lastAuditEventId',
            'updatedAt'
          ])
          && incoming().reviewedByUid == request.auth.uid
          && incoming().reviewedAt == request.time
          && isValidWorkflowTransition(existing().workflowStatus, incoming().workflowStatus)
          && getAfter(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().lastAuditEventId)).data.actorType == 'staff'
          && getAfter(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().lastAuditEventId)).data.action in ['review_started', 'brief_confirmed', 'brief_corrected'])
          ||
          // Action 3: Staff assigns or changes workflow priority (reason required on change)
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'staffAssignedPriority',
            'priorityReason',
            'lastAuditEventId',
            'updatedAt'
          ])
          && getAfter(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().lastAuditEventId)).data.actorType == 'staff'
          && (
            (existing().staffAssignedPriority == 'unassigned'
              && getAfter(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().lastAuditEventId)).data.action == 'priority_assigned')
            ||
            (existing().staffAssignedPriority != 'unassigned'
              && 'priorityReason' in incoming()
              && incoming().priorityReason.size() >= 3
              && getAfter(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().lastAuditEventId)).data.action == 'priority_changed')
          ))
          ||
          // Action 4: Staff transitions workflow status
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'workflowStatus',
            'lastAuditEventId',
            'updatedAt'
          ])
          && (isValidWorkflowTransition(existing().workflowStatus, incoming().workflowStatus)
              || isFacilityAdmin(existing().facilityId))
          && getAfter(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().lastAuditEventId)).data.actorType == 'staff'
          && getAfter(/databases/$(database)/documents/intakes/$(intakeId)/auditEvents/$(incoming().lastAuditEventId)).data.action == 'status_changed')
        );

      allow delete: if false;

      // =======================================================================
      // SUBCOLLECTION 3.1: /intakes/{intakeId}/auditEvents/{eventId}
      // Strictly append-only, immutable 3-actor audit trail (Decision D-007).
      // =======================================================================
      match /auditEvents/{eventId} {
        allow get: if isValidId(intakeId)
          && isValidId(eventId)
          && isActiveStaffForFacility(existing().facilityId);

        allow list: if isValidId(intakeId)
          && isActiveStaffForFacility(existing().facilityId);

        allow create: if isValidId(intakeId)
          && isValidId(eventId)
          && isValidAuditEvent(incoming(), intakeId, eventId)
          && (
            // Branch 1: Initial patient submission event (atomic with new intake)
            (incoming().actorType == 'patient'
              && incoming().action == 'intake_created'
              && !exists(/databases/$(database)/documents/intakes/$(intakeId))
              && existsAfter(/databases/$(database)/documents/intakes/$(intakeId))
              && getAfter(/databases/$(database)/documents/intakes/$(intakeId)).data.initialAuditEventId == eventId
              && getAfter(/databases/$(database)/documents/intakes/$(intakeId)).data.facilityId == incoming().facilityId)
            ||
            // Branch 2: Active facility staff action event (atomic with intake update)
            (incoming().actorType == 'staff'
              && isActiveStaffForFacility(incoming().facilityId)
              && incoming().actorUid == request.auth.uid
              && incoming().actorRole == get(staffDocPath()).data.role
              && incoming().action in [
                'review_started',
                'priority_assigned',
                'priority_changed',
                'status_changed',
                'brief_confirmed',
                'brief_corrected'
              ]
              && (incoming().action != 'priority_changed'
                  || ('reason' in incoming() && incoming().reason.size() >= 3))
              && exists(/databases/$(database)/documents/intakes/$(intakeId))
              && get(/databases/$(database)/documents/intakes/$(intakeId)).data.facilityId == incoming().facilityId
              && getAfter(/databases/$(database)/documents/intakes/$(intakeId)).data.lastAuditEventId == eventId)
            ||
            // Branch 3 (Option 1B): System AI extraction event triggered within active staff session
            (incoming().actorType == 'system'
              && isActiveStaffForFacility(incoming().facilityId)
              && incoming().action in ['ai_completed', 'ai_failed']
              && exists(/databases/$(database)/documents/intakes/$(intakeId))
              && get(/databases/$(database)/documents/intakes/$(intakeId)).data.facilityId == incoming().facilityId
              && getAfter(/databases/$(database)/documents/intakes/$(intakeId)).data.lastAuditEventId == eventId)
          );

        allow update, delete: if false;
      }
    }
  }
}
